{"schemaVersion":1,"generatedAt":1792174267015,"histories":[{"bangumiItem":{"id":266794,"type":2,"name":"Dr.STONE","nameCn":"石纪元","summary":"全人类被神奇的现象一瞬间石化后过了几千年——\r\n拥有超人般头脑、天生的科学少年·千空苏醒了。\r\n在文明遭到毁灭的石头世界（STONE WORLD）里，千空决定要用科学的力量复原整个世界。而与此同时苏醒过来的有，以有着过人体力的儿时玩伴·大木大树为首的伙伴们，从零开始创造文明——\r\n从石器时代到现代文明，一定要赶上这科学史的200万年差距！\r\n前所未闻的创世冒险谭，就此开幕！","airDate":"2019-07-05","airWeekday":5,"rank":1639,"images":{"small":"https://lain.bgm.tv/r/200/pic/cover/l/08/3a/266794_imVve.jpg","grid":"https://lain.bgm.tv/r/100/pic/cover/l/08/3a/266794_imVve.jpg","large":"https://lain.bgm.tv/pic/cover/l/08/3a/266794_imVve.jpg","medium":"https://lain.bgm.tv/r/800/pic/cover/l/08/3a/266794_imVve.jpg","common":"https://lain.bgm.tv/r/400/pic/cover/l/08/3a/266794_imVve.jpg"},"tags":[{"name":"热血","count":1846,"total_cont":0},{"name":"科学","count":1535,"total_cont":0},{"name":"漫画改","count":1412,"total_cont":0},{"name":"2019年7月","count":1286,"total_cont":0},{"name":"科幻","count":1001,"total_cont":0},{"name":"TV","count":965,"total_cont":0},{"name":"战斗","count":754,"total_cont":0},{"name":"漫改","count":747,"total_cont":0},{"name":"JUMP","count":742,"total_cont":0},{"name":"2019","count":592,"total_cont":0},{"name":"TMS","count":485,"total_cont":0},{"name":"日本","count":1,"total_cont":0}],"alias":[],"ratingScore":7.2,"votes":20887,"votesCount":[11,12,24,40,276,1276,3968,2820,429,231],"info":""},"lastWatchEpisode":2,"adapterName":"sorani","lastWatchTime":1786320327853,"lastSrc":"3502","lastWatchEpisodeName":"第02集","entryKind":"online","episodePageUrl":"https://www.sorani.net/anime/mal/3502/episode/2.0","progresses":{"1":{"episode":1,"road":0,"progressMs":0,"updatedAtMs":1786320313208},"2":{"episode":2,"road":0,"progressMs":0,"updatedAtMs":1786320327853}}},{"bangumiItem":{"id":266794,"type":2,"name":"Dr.STONE","nameCn":"石纪元","summary":"全人类被神奇的现象一瞬间石化后过了几千年——\r\n拥有超人般头脑、天生的科学少年·千空苏醒了。\r\n在文明遭到毁灭的石头世界（STONE WORLD）里，千空决定要用科学的力量复原整个世界。而与此同时苏醒过来的有，以有着过人体力的儿时玩伴·大木大树为首的伙伴们，从零开始创造文明——\r\n从石器时代到现代文明，一定要赶上这科学史的200万年差距！\r\